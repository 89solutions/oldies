# Copy to .env (or set these in your host's settings). Leave the TWILIO_* lines
# empty to run in test mode: no real calls or texts, and a simulator at /dev/simulator.

PORT=3000
# The public https address of this app. Twilio sends its webhooks here.
BASE_URL=https://your-app.example.com
DATABASE_PATH=lonely-oldies.db
# Any long random string. Required when Twilio is switched on.
SESSION_SECRET=
# Password for the team page at /admin (username can be anything).
ADMIN_PASSWORD=

# --- Twilio (from console.twilio.com) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The voice + SMS capable number you bought, e.g. +441234567890
TWILIO_PHONE_NUMBER=
# Shown on the website; defaults to TWILIO_PHONE_NUMBER
PUBLIC_PHONE_NUMBER=

# --- Optional tuning ---
# Country code used when people type a number starting with 0 (44 = UK, 1 = US/Canada)
DEFAULT_COUNTRY_CODE=44
TTS_VOICE=Polly.Amy
TTS_LANGUAGE=en-GB
# Times on the website are shown in this time zone
TZ=Europe/London
MATCH_INTERVAL_SECONDS=20
AVAILABLE_FOR_MINUTES=120
MAX_CALL_MINUTES=60
MAX_CALLS_PER_DAY=6
AVOID_REPEAT_DAYS=7
REPORT_SUSPEND_THRESHOLD=2
SMS_CHAT_IDLE_HOURS=12
SCREEN_STRIKES_BEFORE_REPORT=3
MESSAGE_RETENTION_DAYS=30
GROUP_MIN_SIZE=3
GROUP_MAX_SIZE=6
